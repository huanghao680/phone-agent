# Pinned component versions — MUST stay in sync with
# app/src/main/java/com/phoneagent/Versions.kt
NODE_VERSION=26.4.0-1
# upstream Node release the Termux package is built from (node-gyp --target)
NODE_UPSTREAM=26.4.0
NODE_PTY_VERSION=1.2.0-beta.15
ZCODE_VERSION=3.14.4-29
DSH_VERSION=0.2.0-rc.2
CODEX_VERSION=0.157.1
CLAUDE_VERSION=2.1.283
# opencode: Bun single-file executable, launched via the Alpine musl loader
OPENCODE_VERSION=1.18.33
# Alpine packages supplying the musl loader and the GNU C++ runtime opencode needs
LIBSTDCXX_APK=libstdc++-13.2.1_git20240309-r1.apk
LIBGCC_APK=libgcc-13.2.1_git20240309-r1.apk
MUSL_LOADER_VERSION=1.2.5-r3
# static musl ripgrep that backs dsh glob/grep on Android
RIPGREP_VERSION=1.18.0
# pure-JS pnpm for the dsh plugin manager (v12 native exe takes flock-based
# store locks unsupported on the target filesystems)
PNPM_VERSION=10.34.6

# upstream ZCode monorepo ref used to build the web UI + server (v1.5)
ZCODE_UPSTREAM_REF=v3.14.3   # public monorepo has no v3.14.4 tag yet (main == v3.14.3)

# Termux package repository (binaries are standard Android ELFs; the app has
# no dependency on the Termux application itself).
TERMUX_REPO=https://packages.termux.dev/apt/termux-main
# Mirror for CN networks: https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main

# Default npm registry for first-run installs (npmmirror went unreachable;
# Tencent mirrors the same source and verified reachable)
NPM_REGISTRY_DEFAULT=https://mirrors.cloud.tencent.com/npm/
