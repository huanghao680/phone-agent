#!/system/bin/sh
# bwrap-compatible sandbox shim for Android (phone-agent).
#
# dsh-sandbox-local probes and spawns the PATH's `bwrap` with its bwrap
# profile arguments:
#   --ro-bind / / --dev /dev --unshare-pid --proc /proc --die-with-parent
#   [--tmpfs /tmp --bind <workspace> <workspace>]   (workspace-write only)
#   --  bash -c <command>
#
# Android cannot run real bubblewrap unprivileged (no user namespaces), so
# this shim reinterprets the profile with the best available backend:
#   tier 1  landlock-wrap  kernel-enforced, unprivileged, needs kernel 5.13+
#   tier 2  proot          ptrace path rewriting; hides everything outside
#                          the runtime prefix + workspace + temp; works on
#                          any kernel with no root (universal fallback)
# Neither backend can provide an ephemeral /tmp, so the temp fs is mapped to
# $TMPDIR/tmp (and TMPDIR itself stays writable — it is our /tmp equivalent).
# Both tiers govern file effects only, exactly like dsh's own runners.
#
# Fatal shim errors are prefixed "bwrap: " to match the built-in bwrap rung
# runner-failure signature, so a broken backend surfaces as SANDBOX_UNAVAILABLE
# instead of a command failure. A non-zero exit from the COMMAND itself is a
# normal command result and is propagated untouched.

# Locate ourselves: libuv's execvp passes argv[0] as the BARE name ("bwrap")
# while shells pass a path — resolve through PATH when there is no slash.
# Everything here must be pure shell: the sandbox may be spawned with a
# sanitized environment (no LD_LIBRARY_PATH), in which case external commands
# like dirname/basename cannot even link and the shim dies before running
# anything — that is what broke the workflow tool.
SELF="${0:-bwrap}"
case "$SELF" in
*/*) : ;;
*)
	OLDIFS=$IFS
	IFS=:
	for _p in $PATH; do
		[ -x "$_p/$SELF" ] && { SELF="$_p/$SELF"; break; }
	done
	IFS=$OLDIFS
	;;
esac
SELFDIR=${SELF%/*}
case "$SELFDIR" in "$SELF") SELFDIR=. ;; esac
SELFDIR=$(CDPATH= cd -- "$SELFDIR" && pwd)
USR=${SELFDIR%/*}
# Self-sufficient environment: the caller may spawn us with a sanitized
# environment (dsh's tool sandbox does), and every helper this script uses —
# mkdir, chmod, rm, proot itself — is a Termux binary that cannot even link
# without LD_LIBRARY_PATH pointing at the runtime. Derive both from our own
# location so the shim never depends on what it inherited.
LD_LIBRARY_PATH="$USR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
case ":$PATH:" in
*":$USR/bin:"*) : ;;
*) PATH="$USR/bin:$PATH"; export PATH ;;
esac
LANDLOCK="$USR/bin/landlock-wrap"
PROOT="$USR/bin/proot"

MODE=ro
WS=
TMPFS_DST=
while [ $# -gt 0 ]; do
	case "$1" in
	--ro-bind) shift 3 ;;
	--bind) WS="$2"; MODE=ws; shift 3 ;;
	--tmpfs) TMPFS_DST="$2"; shift 2 ;;
	--dev|--proc|--chdir) shift 2 ;;
	--unshare-pid|--die-with-parent) shift 1 ;;
	--) shift; break ;;
	-*) shift 1 ;;
	*) break ;;
	esac
done
# "$@" now holds the command argv.

fatal() {
	echo "bwrap: phone-agent shim: $*" >&2
	exit 1
}

# $USR is <files>/usr, so its grandparent is the app data dir; derive the cache
# path from it without external commands (see the note above).
APPDIR=${USR%/*}   # <files>
APPDIR=${APPDIR%/*} # app data dir
[ -n "$TMPDIR" ] || TMPDIR="$APPDIR/cache"
mkdir -p "$TMPDIR" 2>/dev/null || true

# ---- tier 1: Landlock (kernel-enforced, unprivileged) -----------------------
if [ -x "$LANDLOCK" ] && "$LANDLOCK" --probe >/dev/null 2>&1; then
	set -A PFX "$LANDLOCK" --ro /
	set -A PFX "${PFX[@]}" --rw /dev/null
	set -A PFX "${PFX[@]}" --rw "$TMPDIR"
	[ "$MODE" = ws ] && set -A PFX "${PFX[@]}" --rw "$WS"
	exec "${PFX[@]}" -- "$@"
fi

# ---- tier 2: proot (universal, userland) ------------------------------------
[ -x "$PROOT" ] || fatal "no usable backend (landlock unavailable, proot missing)"
# Termux-built proot looks for its ptrace loader under the Termux prefix;
# point it at our runtime copy explicitly.
if [ -x "$USR/libexec/proot/loader" ]; then
	PROOT_LOADER="$USR/libexec/proot/loader"
	export PROOT_LOADER
fi
# proot also defaults its scratch dir to the Termux prefix; use our temp.
PROOT_TMP_DIR="$TMPDIR/tmp"
export PROOT_TMP_DIR

SKEL="$TMPDIR/bwrap-shim-root.$$"
rm -rf "$SKEL" 2>/dev/null || true
mkdir -p "$SKEL" || fatal "cannot create skeleton root under $TMPDIR"
cleanup() {
	chmod -R u+w "$SKEL" 2>/dev/null
	rm -rf "$SKEL" 2>/dev/null
}
trap 'cleanup' EXIT
# job_kill sends SIGTERM to the process group: without this the frozen
# skeleton survives (its read-only dirs block a plain rm) and every killed job
# leaks a tree into the cache directory
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 130' INT

set -A PFX "$PROOT" -r "$SKEL"
# read-only host system trees (execution + libraries)
for _d in system vendor product apex odm system_ext linkerconfig; do
	[ -d "/$_d" ] || continue
	set -A PFX "${PFX[@]}" -b "/$_d:/$_d"
	mkdir -p "$SKEL/$_d" 2>/dev/null || true
done
set -A PFX "${PFX[@]}" -b /dev:/dev -b /proc:/proc -b /sys:/sys
mkdir -p "$SKEL/dev" "$SKEL/proc" "$SKEL/sys" 2>/dev/null || true
# the spawning process's cwd must exist in the guest tree, or proot gives up on
# it and silently falls back to "/" (making relative paths resolve wrongly)
CWD=$(pwd 2>/dev/null || echo "")
if [ -n "$CWD" ] && [ "$CWD" != "/" ]; then
	mkdir -p "$SKEL$CWD" 2>/dev/null || true
fi
# the runtime prefix at its real path (node/bash/agents live here)
set -A PFX "${PFX[@]}" -b "$USR:$USR"
mkdir -p "$SKEL$USR" 2>/dev/null || true
# temp: TMPDIR at its real path (rw), plus the /tmp spelling of the same dir
if [ -n "$TMPDIR" ]; then
	mkdir -p "$TMPDIR/tmp" 2>/dev/null || true
	set -A PFX "${PFX[@]}" -b "$TMPDIR:$TMPDIR" -b "$TMPDIR/tmp:/tmp"
	mkdir -p "$SKEL$TMPDIR" "$SKEL/tmp" 2>/dev/null || true
fi
# the workspace is the only other writable root (workspace-write mode)
if [ "$MODE" = ws ] && [ -n "$WS" ]; then
	mkdir -p "$WS" 2>/dev/null || true
	set -A PFX "${PFX[@]}" -b "$WS:$WS"
	mkdir -p "$SKEL$WS" 2>/dev/null || true
fi
# Freeze the skeleton itself: a write to an unbound path can only land in the
# ephemeral skeleton, where it would silently "succeed" and vanish. Freezing
# turns that into a real EACCES denial the agent can see (and dsh classifies
# it as a policy denial). The allowed mount points keep their write bit — proot
# resolves through them.
chmod -R a-w "$SKEL" 2>/dev/null || true
chmod 755 "$SKEL/tmp" 2>/dev/null || true
[ -n "$TMPDIR" ] && chmod 755 "$SKEL$TMPDIR" 2>/dev/null
if [ "$MODE" = ws ] && [ -n "$WS" ]; then
	chmod 755 "$SKEL$WS" 2>/dev/null || true
fi
# $HOME outside the visible tree would break tools that touch it; remap it
# into the temp dir (read of the real home is not promised in either mode)
REMAP_HOME=1
case "$HOME" in
"$TMPDIR"/*|"$USR"/*) REMAP_HOME=0 ;;
esac
if [ -n "$WS" ]; then
	case "$HOME" in
	"$WS"|"$WS"/*) REMAP_HOME=0 ;;
	esac
fi
if [ -z "$HOME" ] || [ "$REMAP_HOME" = 1 ]; then
	HOME="$TMPDIR/tmp/home"
	mkdir -p "$HOME" 2>/dev/null || true
	export HOME
fi

# Run proot as a child rather than exec'ing it: the skeleton must be thawed and
# removed afterwards, which an exec'd process can never do (that is how the
# frozen roots used to pile up in TMPDIR).
"${PFX[@]}" "$@"
RC=$?
cleanup
exit $RC
