<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ic_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/settings_label"
            android:textColor="#E2E8F0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DeepSeek API Key（dsh 使用）"
            android:textColor="#94A3B8" />

        <EditText
            android:id="@+id/key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:textColor="#E2E8F0"
            android:textColorHint="#475569" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="npm 镜像源（首次安装组件时使用）"
            android:textColor="#94A3B8" />

        <EditText
            android:id="@+id/registry_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#E2E8F0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="HTTP 代理（可选；手机直连 registry 超时时填写，Node 不读系统 WiFi 代理）"
            android:textColor="#94A3B8" />

        <EditText
            android:id="@+id/proxy_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.197:7890"
            android:inputType="textUri"
            android:textColor="#E2E8F0"
            android:textColorHint="#475569" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="Agent 组件更新（zcode / dsh）"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="点击检查后显示版本对比"
            android:textColor="#94A3B8"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/check_updates_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="检查更新" />

        <Button
            android:id="@+id/update_zcode_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="更新 zcode" />

        <Button
            android:id="@+id/update_dsh_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="更新 dsh" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="工作区目录（可选；授权后 zcode/dsh 以它为工作根目录）"
            android:textColor="#94A3B8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pick_workspace_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择目录" />

            <Button
                android:id="@+id/clear_workspace_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清除" />
        </LinearLayout>

        <TextView
            android:id="@+id/workspace_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未选择（默认使用 APP 私有目录）"
            android:textColor="#94A3B8"
            android:textIsSelectable="true" />

        <Switch
            android:id="@+id/root_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="root 深度集成（Magisk 模块 / 系统级命令）"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/install_module_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="安装系统级命令 zcode / dsh（root）" />

        <Button
            android:id="@+id/uninstall_module_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="卸载系统级命令（root）" />

        <Button
            android:id="@+id/phantom_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="修复后台幻象进程限制（root）" />

        <Button
            android:id="@+id/reinit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="重新初始化运行时（清空重装）" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textColor="#94A3B8"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
