<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ic_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/settings_label"
            android:textColor="#E2E8F0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DeepSeek API Key（dsh 使用）"
            android:textColor="#94A3B8" />

        <EditText
            android:id="@+id/key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:textColor="#E2E8F0"
            android:textColorHint="#475569" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="npm 镜像源（首次安装组件时使用）"
            android:textColor="#94A3B8" />

        <EditText
            android:id="@+id/registry_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#E2E8F0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="HTTP 代理（可选；手机直连 registry 超时时填写，Node 不读系统 WiFi 代理）"
            android:textColor="#94A3B8" />

        <EditText
            android:id="@+id/proxy_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.197:7890"
            android:inputType="textUri"
            android:textColor="#E2E8F0"
            android:textColorHint="#475569" />

        <Switch
            android:id="@+id/root_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="root 深度集成（Magisk 模块 / 系统级命令）"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/install_module_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="安装系统级命令 zcode / dsh（root）" />

        <Button
            android:id="@+id/uninstall_module_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="卸载系统级命令（root）" />

        <Button
            android:id="@+id/phantom_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="修复后台幻象进程限制（root）" />

        <Button
            android:id="@+id/reinit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="重新初始化运行时（清空重装）" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textColor="#94A3B8"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
