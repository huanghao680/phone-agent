<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".AgentApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PhoneAgent">
        <!-- Launcher icon 1: terminal picker (zcode / dsh / codex / claude / opencode TUI) -->
        <activity
            android:name=".TerminalPickerActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_terminal"
            android:label="@string/terminal_label"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launcher icon 2: DeepSeek Harness web UI -->
        <activity
            android:name=".DshActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_dsh"
            android:label="@string/dsh_label"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handover target: "share with Phone Agent" / "open with Phone Agent".
             Takes the file into a temp workspace and opens a new session there. -->
        <activity
            android:name=".FileIncomingActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-python" />
                <data android:mimeType="text/javascript" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Launcher icon 3: official ZCode web UI -->
        <activity
            android:name=".ZcodeWebActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_zcode_web"
            android:label="@string/zcode_web_label"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launcher icon 4: opencode web UI -->
        <activity
            android:name=".OpencodeWebActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_opencode"
            android:label="@string/opencode_label"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DiagActivity"
            android:exported="false"
            android:label="诊断" />

        <activity
            android:name=".UsageActivity"
            android:exported="false"
            android:label="@string/usage_title" />

        <!-- Shared PTY terminal host for the TUIs chosen in TerminalPicker -->
        <activity
            android:name=".ZcodeTerminalActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="@string/zcode_label"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PhoneAgent.Terminal" />

        <activity
            android:name=".CodexTerminalActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="Codex TUI"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PhoneAgent.Terminal" />

        <activity
            android:name=".ClaudeTerminalActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="Claude Code TUI"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PhoneAgent.Terminal" />

        <activity
            android:name=".OpencodeTerminalActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="opencode TUI"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PhoneAgent.Terminal" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_label" />

        <service
            android:name=".ZcodeWebService"
            android:exported="false" />

        <service
            android:name=".DshService"
            android:exported="false" />

        <service
            android:name=".SessionService"
            android:exported="false" />
            <!-- Loopback tool channel: lets agent sessions read the screen, dump the
             UI tree, tap and run privileged shell commands via Shizuku. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".BrowserWorkbenchActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="AI 浏览器" />

        <service
            android:name=".A11yService"
            android:exported="false"
            android:label="phone-agent 设备工具"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_service_config" />
        </service>

        <service
            android:name=".PhoneToolService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".OpencodeWebService"
            android:exported="false" />

        <!-- Shizuku: receives the Shizuku server binder so this app can use
             shell-uid APIs (opencode webui spawn, phantom-process fix) on
             devices without root -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

</application>
</manifest>
