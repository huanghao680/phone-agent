<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".AgentApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PhoneAgent">
        <!-- Launcher icon 1: terminal picker (zcode / dsh / opencode TUI) -->
        <activity
            android:name=".TerminalPickerActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_zcode"
            android:label="@string/terminal_label"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launcher icon 2: DeepSeek Harness web UI -->
        <activity
            android:name=".DshActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_dsh"
            android:label="@string/dsh_label"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launcher icon 3: official ZCode web UI -->
        <activity
            android:name=".ZcodeWebActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_zcode_web"
            android:label="@string/zcode_web_label"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UsageActivity"
            android:exported="false"
            android:label="@string/usage_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_label" />

        <service
            android:name=".ZcodeWebService"
            android:exported="false" />

        <service
            android:name=".DshService"
            android:exported="false" />

        <service
            android:name=".SessionService"
            android:exported="false" />
    </application>
</manifest>
